# Postgres connection string. Locally: postgresql://postgres:postgres@localhost:5432/simplelanguage
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# DeepInfra API token, used for Kokoro-82M text-to-speech.
DEEPINFRA_API_TOKEN=""

# OpenAI API key, used for translation candidates, phonetic respellings, and word suggestions.
OPENAI_API_KEY=""

# OpenAI model id used for structured translation/suggestion generation.
# If this model id turns out to be invalid, this is the only line that needs to change.
OPENAI_MODEL="gpt-5.6-luna"
